@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject MarketplaceBranding Branding

<div class="page @(IsStorefront ? "tenant-site" : null)" style="@(Branding.Colour is null ? null : $"--tenant-primary:{Branding.Colour};--tenant-ink:{StorefrontPresentation.BrandInk(Branding.Colour)};")">
    <main class="w-100">
        @if (IsStorefront)
        {
            <a class="storefront-skip" href="#main-content">Skip to content</a>
            <StorefrontHeader />
        }
        else
        {
        <nav class="navbar navbar-expand navbar-dark bg-dark px-3">
            <NavLink class="navbar-brand" href="/" aria-label="@($"{Branding.Name} home")">
                @if (!string.IsNullOrWhiteSpace(Branding.Logo))
                {
                    <img src="@Branding.Logo" alt="@Branding.Name" class="navbar-brand__logo" />
                }
                else
                {
                    <span class="navbar-brand__tenant-name">@Branding.Name</span>
                }
            </NavLink>

            <div class="navbar-nav">
                @if (!IsPlatformHost())
                {
                    <NavLink class="nav-link" href="/browse">Browse Listings</NavLink>

                    <AuthorizeView Roles="Seller">
                        <Authorized>
                            <NavLink class="nav-link" href="/seller/my-listings">My Listings</NavLink>
                        </Authorized>
                    </AuthorizeView>
                }

                <AuthorizeView Roles="TenantAdmin">
                    <Authorized>
                        <NavLink class="nav-link" href="/tenant" Match="NavLinkMatch.All">Tenant</NavLink>
                        <NavLink class="nav-link" href="/tenant/listings">Listings</NavLink>
                        <NavLink class="nav-link" href="/tenant/users">Tenant Users</NavLink>
                        <NavLink class="nav-link" href="/tenant/settings">Settings</NavLink>
                        <NavLink class="nav-link" href="/tenant/orders">Orders</NavLink>
                        <NavLink class="nav-link" href="/tenant/payments">Payments</NavLink>
                        <NavLink class="nav-link" href="/tenant/charges">Charges</NavLink>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Roles="PlatformAdmin,PlatformSuperAdmin,PlatformComplianceAdmin,PlatformSupport">
                    <Authorized>
                        <NavLink class="nav-link" href="/platform" Match="NavLinkMatch.All">Platform</NavLink>
                        <NavLink class="nav-link" href="/platform/users">Users</NavLink>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Roles="Buyer"><Authorized><NavLink class="nav-link" href="/buyer/orders">My Orders</NavLink></Authorized></AuthorizeView>
                <AuthorizeView Roles="PlatformSuperAdmin,PlatformComplianceAdmin"><Authorized><NavLink class="nav-link" href="/platform/compliance">Compliance Queue</NavLink></Authorized></AuthorizeView>
            </div>

            <div class="navbar-nav ms-auto">
                <AuthorizeView Context="auth">
                    <NotAuthorized>
                        <NavLink class="nav-link" href="/login">Login</NavLink>
                        @if (!IsPlatformHost())
                        {
                            <NavLink class="nav-link" href="/register">Register</NavLink>
                        }
                    </NotAuthorized>
                    <Authorized>
                        <span class="navbar-text text-light me-2">Hi, @(auth.User.Identity?.Name ?? auth.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value)
                        </span>
                        <NavLink class="nav-link" href="/logout">Logout</NavLink>
                    </Authorized>
                </AuthorizeView>
            </div>
        </nav>
        }

        <article id="main-content" tabindex="-1" class="@(IsStorefront ? "content storefront-content" : "content px-4")">
            @Body
        </article>
        @if (IsStorefront) { <StorefrontFooter /> }
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <NavLink href="." class="reload">Reload</NavLink>
    <span class="dismiss">🗙</span>
</div>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private bool IsPlatformHost() => PlatformHostRules.IsPlatformHost(Nav.ToAbsoluteUri(Nav.Uri).Host);
    private bool IsStorefront => !IsPlatformHost() && StorefrontPath(Nav.ToAbsoluteUri(Nav.Uri).AbsolutePath);
    private static bool StorefrontPath(string path) => path is "/" or "/browse" or "/login" or "/register" or "/logout" or "/forgot-password" or "/reset-password"
        || path.StartsWith("/listings/", StringComparison.Ordinal) || path.StartsWith("/auctions/", StringComparison.Ordinal) || path.StartsWith("/buyer/", StringComparison.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        Branding.Changed += BrandChanged;
        await Branding.EnsureLoadedAsync();
    }
    private void BrandChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Branding.Changed -= BrandChanged;
}
