@page "/tenant/payments"
@using Faunex.Application.DTOs
@inject Faunex.Web.Api.FaunexApiClient Api
<PageTitle>PayFast Settings - Faunex</PageTitle>
<AuthorizeView Roles="TenantAdmin"><Authorized>
<section class="platform-shell payment-settings">
    <div class="platform-header platform-header--compact"><div><p class="platform-kicker">Tenant payments</p><h1>PayFast Settings</h1></div><a class="btn btn-outline-secondary" href="/tenant/orders">Orders</a></div>
    @if (_error is not null) { <div class="alert alert-danger" role="alert">@_error</div> }
    @if (_notice is not null) { <div class="alert alert-success" role="status">@_notice</div> }
    @if (_loading) { <p role="status">Loading payment settings...</p> }
    else if (_settings is not null)
    {
        <div class="files-summary"><span class="platform-status">Sandbox</span><span>@(_settings.HasCredentials ? "Credentials stored" : "Not configured")</span><span>@(_settings.CheckoutAvailable ? "Sandbox checkout enabled" : "Sandbox checkout unavailable")</span></div>
        <form @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <fieldset disabled="@_busy">
                <div class="platform-form-grid">
                    <div><label for="payfast-id" class="form-label">Sandbox merchant ID</label><input id="payfast-id" class="form-control" @bind="_merchantId" pattern="[0-9]{8}" maxlength="8" required /></div>
                    <div><label for="payfast-key" class="form-label">Sandbox merchant key</label><input id="payfast-key" class="form-control" type="@(_show ? "text" : "password")" @bind="_key" autocomplete="new-password" maxlength="13" /></div>
                    <div><label for="payfast-passphrase" class="form-label">Sandbox passphrase</label><input id="payfast-passphrase" class="form-control" type="@(_show ? "text" : "password")" @bind="_passphrase" autocomplete="new-password" maxlength="32" /></div>
                </div>
                <label class="form-check mt-3"><input class="form-check-input" type="checkbox" @bind="_show" /> Show entered credentials</label>
                <div class="platform-form-actions"><button class="btn btn-primary" type="submit">@(_busy ? "Saving..." : "Save Sandbox Settings")</button><button class="btn btn-outline-secondary" type="button" @onclick="LoadAsync">Reload</button>
                @if (_settings.HasCredentials) { <button class="btn btn-outline-danger" type="button" @onclick="() => _confirmRemove = true">Remove Credentials</button> }</div>
            </fieldset>
        </form>
        @if (_confirmRemove)
        {
            <div class="review-confirm"><p>Remove the stored sandbox credentials?</p><div class="file-actions"><button class="btn btn-danger" disabled="@_busy" @onclick="RemoveAsync">Confirm Removal</button><button class="btn btn-outline-secondary" disabled="@_busy" @onclick="() => _confirmRemove = false">Cancel</button></div></div>
        }
    }
</section>
</Authorized><NotAuthorized><p>You do not have access to tenant payment settings.</p></NotAuthorized></AuthorizeView>
@code {
    private PayFastSettingsDto? _settings;
    private string _merchantId = "", _key = "", _passphrase = "";
    private string? _error, _notice;
    private bool _loading = true, _busy, _show, _confirmRemove;
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        _loading = true; _error = null; _key = _passphrase = ""; _show = _confirmRemove = false;
        try { _settings = await Api.GetAsync<PayFastSettingsDto>("/api/tenant/payments/payfast"); _merchantId = _settings?.MerchantId ?? ""; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }
    private async Task SaveAsync()
    {
        if (_busy || _settings is null) return;
        _busy = true; _error = _notice = null;
        try
        {
            _settings = await Api.PutAsync<SavePayFastSettingsRequest, PayFastSettingsDto>("/api/tenant/payments/payfast", new(_settings.Revision, _merchantId, _key, _passphrase));
            _notice = "Sandbox settings saved.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _key = _passphrase = ""; _show = false; _busy = false; }
    }
    private async Task RemoveAsync()
    {
        if (_busy || _settings is null) return;
        _busy = true; _error = _notice = null;
        try { await Api.DeleteAsync($"/api/tenant/payments/payfast?revision={_settings.Revision}"); await LoadAsync(); _notice = "Sandbox credentials removed."; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; _confirmRemove = false; }
    }
}
