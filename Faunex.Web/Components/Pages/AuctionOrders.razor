@page "/buyer/orders"
@page "/tenant/orders"
@using Faunex.Application.DTOs
@using Faunex.Web.Payments
@inject Faunex.Web.Api.FaunexApiClient Api
@inject NavigationManager Nav
<PageTitle>Orders - Faunex</PageTitle>
<AuthorizeView Roles="Buyer,TenantAdmin"><Authorized>
<section class="platform-shell orders-workspace">
    <div class="platform-header platform-header--compact"><div><p class="platform-kicker">Auction results</p><h1>@(IsTenant ? "Tenant Orders" : "My Orders")</h1></div>@if (IsTenant) { <a class="btn btn-outline-secondary" href="/tenant/payments">PayFast Settings</a> }</div>
    <form class="platform-list-toolbar order-list-toolbar" @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <div><label for="order-search" class="form-label">Search orders</label><input id="order-search" class="form-control" maxlength="200" @bind="_search" /></div>
        <div><label for="order-payment-stage" class="form-label">Payment stage</label><select id="order-payment-stage" class="form-select" @bind="_stage">
            <option value="">All stages</option>
            @foreach (var stage in Stages) { <option value="@stage">@OrderPaymentDisplay.Label(stage)</option> }
        </select></div>
        <button class="btn btn-outline-secondary" disabled="@_loading" type="submit">Search</button>
    </form>
    @if (_error is not null) { <div class="alert alert-danger" role="alert">@_error</div> }
    @if (_loading) { <p role="status">Loading orders...</p> }
    else if (_result is not null)
    {
        @if (_result.Total == 0) { <p>No orders found.</p> }
        else
        {
            <div class="platform-table-wrap"><table class="table platform-table order-table">
                <thead><tr><th>Listing / reference</th><th>Lot subtotal</th><th>Final total</th><th>Payment stage</th><th>Actions</th></tr></thead>
                <tbody>@foreach (var order in _result.Items) {
                    <tr><td><strong>@order.Title</strong><small class="order-reference">@order.Id</small></td>
                        <td>@order.Amount.ToString("0.00") @order.CurrencyCode</td>
                        <td>@(order.Quote is null ? "Not finalised" : $"{order.Quote.Pricing.Total:0.00} {order.Quote.Pricing.CurrencyCode}")</td>
                        <td><span class="platform-status">@(order.Released ? "Reservation released" : OrderPaymentDisplay.Label(order.PaymentStage))</span></td>
                        <td><a aria-label="@($"View order {order.Id}")" href="@(Prefix + "/" + order.Id)">View</a></td></tr>
                }</tbody>
            </table></div>
            <div class="review-pagination"><button class="btn btn-outline-secondary" disabled="@(_loading || _skip == 0)" @onclick="PreviousAsync">Previous</button><span>@_result.Total order(s)</span><button class="btn btn-outline-secondary" disabled="@(_loading || _skip + 25 >= _result.Total)" @onclick="NextAsync">Next</button></div>
        }
    }
</section>
</Authorized><NotAuthorized><p>Login with your buyer or tenant administrator account to view orders.</p></NotAuthorized></AuthorizeView>
@code {
    private string _search = "";
    private string _stage = "";
    private static readonly string[] Stages = [OrderPaymentStages.Pricing, OrderPaymentStages.Unpaid, OrderPaymentStages.Pending, OrderPaymentStages.Confirmed, OrderPaymentStages.Review];
    private int _skip;
    private bool _loading;
    private string? _error;
    private PagedResult<AuctionOrderDto>? _result;
    private bool IsTenant => Nav.ToAbsoluteUri(Nav.Uri).AbsolutePath.StartsWith("/tenant/", StringComparison.Ordinal);
    private string Prefix => IsTenant ? "/tenant/orders" : "/buyer/orders";
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync() { if (_loading) return; _loading = true; _error = null; _result = null; try { _result = await Api.GetAsync<PagedResult<AuctionOrderDto>>($"/api/orders?search={Uri.EscapeDataString(_search)}&paymentStage={Uri.EscapeDataString(_stage)}&skip={_skip}&take=25"); } catch (Exception ex) { _error = ex.Message; } finally { _loading = false; } }
    private async Task SearchAsync() { _skip = 0; await LoadAsync(); }
    private async Task PreviousAsync() { if (_loading) return; _skip = Math.Max(0, _skip - 25); await LoadAsync(); }
    private async Task NextAsync() { if (_loading) return; _skip += 25; await LoadAsync(); }
}
