@page "/platform/compliance"
@using Faunex.Application.DTOs
@inject Faunex.Web.Api.FaunexApiClient Api
<PageTitle>Compliance Queue - Faunex</PageTitle>
<AuthorizeView Roles="PlatformSuperAdmin,PlatformComplianceAdmin">
    <Authorized>
        <section class="platform-shell">
            <div class="platform-header platform-header--compact"><div><p class="platform-kicker">Platform operations</p><h1>Compliance Queue</h1></div><button class="btn btn-outline-secondary" disabled="@_busy" @onclick="LoadAsync">Refresh</button></div>
            <form class="review-queue-filters" @onsubmit="SearchAsync" @onsubmit:preventDefault>
                <div><label class="form-label" for="review-search">Search listings, tenants or sellers</label><input class="form-control" id="review-search" @bind="_search" maxlength="160" /></div>
                <div><label class="form-label" for="review-status">Status</label><select class="form-select" id="review-status" @bind="_status">@foreach (var status in Statuses) { <option value="@status">@status</option> }</select></div>
                <button class="btn btn-primary" type="submit" disabled="@_busy">Search</button>
            </form>
            @if (_error is not null) { <div class="alert alert-danger" role="alert">@_error</div> }
            @if (_busy) { <p role="status">Loading queue...</p> }
            else if (_queue is not null)
            {
                <p class="text-muted">@_queue.Total listing(s)</p>
                @if (_queue.Items.Count == 0) { <p>No matching listings.</p> }
                else
                {
                    <div class="platform-table-wrap"><table class="table platform-table"><thead><tr><th>Listing</th><th>Tenant</th><th>Seller</th><th>Status</th><th>Submitted (UTC)</th><th>Files</th><th>Actions</th></tr></thead><tbody>
                    @foreach (var row in _queue.Items)
                    {
                        <tr @key="row.Id"><td>@row.Title</td><td>@row.TenantName</td><td>@row.SellerName</td><td>@row.Status</td><td>@(row.SubmittedAt?.ToString("dd MMM yyyy HH:mm") ?? "-")</td><td>@row.FileCount</td><td><a class="btn btn-outline-secondary btn-sm" href="@($"/platform/compliance/listings/{row.Id}")">Review</a></td></tr>
                    }
                    </tbody></table></div>
                }
                <div class="review-pagination"><button class="btn btn-outline-secondary" disabled="@(_busy || _skip == 0)" @onclick="PreviousAsync">Previous</button><span>Page @(_skip / 25 + 1)</span><button class="btn btn-outline-secondary" disabled="@(_busy || _skip + 25 >= _queue.Total)" @onclick="NextAsync">Next</button></div>
            }
        </section>
    </Authorized>
    <NotAuthorized><h1>Review Access Required</h1><a href="/login">Login</a></NotAuthorized>
</AuthorizeView>
@code {
    private static readonly string[] Statuses = ["UnderReview", "PendingDocuments", "Rejected", "Approved", "Suspended", "Draft", "All"];
    private ReviewQueueResult? _queue;
    private string _status = "UnderReview", _search = "";
    private string? _error;
    private int _skip;
    private bool _busy;
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task SearchAsync() { _skip = 0; await LoadAsync(); }
    private async Task PreviousAsync() { _skip = Math.Max(0, _skip - 25); await LoadAsync(); }
    private async Task NextAsync() { _skip += 25; await LoadAsync(); }
    private async Task LoadAsync()
    {
        _busy = true; _error = null; _queue = null;
        try { _queue = await Api.GetAsync<ReviewQueueResult>($"/api/platform/compliance/listings?status={Uri.EscapeDataString(_status)}&search={Uri.EscapeDataString(_search)}&skip={_skip}&take=25"); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
