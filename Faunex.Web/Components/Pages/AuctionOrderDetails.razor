@page "/buyer/orders/{OrderId:guid}"
@page "/tenant/orders/{OrderId:guid}"
@page "/buyer/orders/from-auction/{AuctionId:guid}"
@using Faunex.Application.DTOs
@inject Faunex.Web.Api.FaunexApiClient Api
@inject NavigationManager Nav
<PageTitle>Order - Faunex</PageTitle>
<AuthorizeView Roles="Buyer,TenantAdmin"><Authorized>
<section class="platform-shell orders-workspace">
    <a class="order-back-link" href="@(IsBuyerRoute ? "/buyer/orders" : "/tenant/orders")">Back to orders</a>
    <div class="platform-header platform-header--compact"><div><p class="platform-kicker">@(_order?.AuctionId is null ? "Order" : "Winner order")</p><h1>@(_order?.Title ?? "Order")</h1></div><button class="btn btn-outline-secondary" disabled="@(_loading || _releasing)" @onclick="LoadAsync">Refresh</button></div>
    @if (_error is not null) { <div class="alert alert-danger" role="alert">@_error</div> }
    @if (_loading) { <p role="status">Loading order...</p> }
    else if (_order is not null)
    {
        <div class="files-summary"><span class="platform-status">No live payments enabled</span><span>@(_order.Released ? "Reservation released" : _order.Quote is null ? "Charges not finalised" : "Pricing finalised")</span></div>
        <dl class="review-facts"><dt>Order reference</dt><dd>@_order.Id</dd><dt>Lot quantity</dt><dd>@_order.Quantity</dd><dt>@(_order.AuctionId is null ? "Lot subtotal" : "Winning lot subtotal")</dt><dd>@_order.Amount.ToString("0.00") @_order.CurrencyCode</dd><dt>Recorded (SAST)</dt><dd>@_order.CreatedAt.ToOffset(TimeSpan.FromHours(2)).ToString("dd MMM yyyy HH:mm:ss")</dd></dl>
        @if (!_order.Released)
        {
            <OrderPricing @key="_order.Id" OrderId="_order.Id" Quote="_order.Quote" CanChoose="IsBuyerRoute" Updated="LoadAsync" />
            @if (_order.Quote is not null) { <PayFastPayment OrderId="_order.Id" Summary="_order.Payment" CanPrepare="_order.CheckoutAvailable" CanPay="IsBuyerRoute" ReturnState="@PaymentReturn" /> }
        }
        <div class="d-flex flex-wrap gap-2 mt-4">
            <a class="btn btn-outline-secondary" href="@($"/{(_order.AuctionId is null ? "listings" : "auctions")}/{_order.ListingId}")">@(_order.AuctionId is null ? "View lot" : "Auction Result")</a>
            @if (_order.CanRelease)
            {
                @if (_confirmRelease)
                {
                    <button class="btn btn-outline-danger" disabled="@_releasing" @onclick="ReleaseAsync">Confirm release</button>
                    <button class="btn btn-outline-secondary" disabled="@_releasing" @onclick="() => _confirmRelease = false">Keep reservation</button>
                }
                else { <button class="btn btn-outline-secondary" @onclick="() => _confirmRelease = true">Release reservation</button> }
            }
        </div>
    }
</section>
</Authorized><NotAuthorized><p>Login with your buyer or tenant administrator account to view this order.</p></NotAuthorized></AuthorizeView>
@code {
    [Parameter] public Guid OrderId { get; set; }
    [Parameter] public Guid AuctionId { get; set; }
    [SupplyParameterFromQuery(Name = "payment")] public string? PaymentReturn { get; set; }
    private AuctionOrderDto? _order;
    private bool _loading;
    private bool _confirmRelease, _releasing;
    private string? _error;
    private bool IsBuyerRoute => Nav.ToAbsoluteUri(Nav.Uri).AbsolutePath.StartsWith("/buyer/", StringComparison.Ordinal);
    protected override Task OnParametersSetAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        _loading = true; _error = null; _order = null;
        try { _order = Nav.ToAbsoluteUri(Nav.Uri).AbsolutePath.StartsWith("/buyer/orders/from-auction/", StringComparison.Ordinal) ? await Api.PostAsync<object, AuctionOrderDto>($"/api/orders/from-auction/{AuctionId}", new { }) : await Api.GetAsync<AuctionOrderDto>($"/api/orders/{OrderId}"); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }
    private async Task ReleaseAsync()
    {
        if (_releasing || _order is not { CanRelease: true } order) return;
        _releasing = true; _error = null;
        try
        {
            await Api.PostAsync($"/api/fixed-price/orders/{order.Id:D}/release", new { });
            _confirmRelease = false;
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _releasing = false; }
    }
}
