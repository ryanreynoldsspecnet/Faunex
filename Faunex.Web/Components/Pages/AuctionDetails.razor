@page "/auctions/{ListingId:guid}"
@using Faunex.Application.DTOs
@implements IAsyncDisposable
@inject Faunex.Web.Api.FaunexApiClient Api
@inject NavigationManager Nav
@inject AuthenticationStateProvider Auth
<PageTitle>Auction - Faunex</PageTitle>
<section class="platform-shell auction-workspace">
    <div class="platform-header platform-header--compact"><div><p class="platform-kicker">Timed auction</p><h1>@(_listing?.Title ?? "Auction")</h1></div><button class="btn btn-outline-secondary" disabled="@_busy" @onclick="RefreshAsync">Refresh</button></div>
    @if (_error is not null) { <div class="alert alert-danger" role="alert">@_error</div> }
    @if (_notice is not null) { <div class="alert alert-success" role="status">@_notice</div> }
    @if (_loading) { <p role="status">Loading auction...</p> }
    else if (_listing is not null)
    {
        <ListingPhotoGallery ListingId="ListingId" Title="@_listing.Title" />
        @if (_auction is null) { <p>No published timed auction.</p> }
        else
        {
            <div class="files-summary my-3"><span class="platform-status">@_auction.State</span>@if (_auction.Outcome is not null) { <strong>Result: @_auction.Outcome</strong> }</div>
            <dl class="review-facts my-4">
                <dt>Start (SAST)</dt><dd>@Time(_auction.StartsAt)</dd><dt>End (SAST)</dt><dd>@Time(_auction.EndsAt)</dd>
                <dt>Starting price</dt><dd>@Money(_auction.StartingPrice)</dd><dt>Highest bid</dt><dd>@(_auction.CurrentPrice is { } top ? Money(top) : "No bids")</dd>
                <dt>Increment</dt><dd>@Money(_auction.MinimumIncrement)</dd><dt>Minimum next bid</dt><dd>@Money(Minimum)</dd><dt>Server update</dt><dd>@Time(_auction.ServerTime)</dd>
            </dl>
            @if (_auction.Charges is { } charges)
            {
                <section class="auction-charges"><h2>Recorded Delivery &amp; Charges</h2><p class="review-notes">@charges.Terms</p><dl class="review-facts">@foreach (var option in charges.Options) { <dt>@option.Name</dt><dd>@option.Amount.ToString("0.00") @charges.CurrencyCode - @(option.Kind == "Delivery" ? "Delivery / collection choice" : option.Kind == "RequiredExtra" ? "Required per lot" : "Optional per lot")<small>@option.Description</small></dd> }</dl></section>
            }
            else { <p class="alert alert-warning">No pricing terms recorded. Online checkout unavailable for this auction.</p> }
            @if (_buyer && _auction.State == "Live")
            {
                <form class="auction-bid-form" @onsubmit="BidAsync" @onsubmit:preventDefault><label class="form-label" for="bid-amount">Bid amount (@_listing.CurrencyCode)</label><div class="file-actions"><input id="bid-amount" class="form-control" type="number" min="@Minimum.ToString(System.Globalization.CultureInfo.InvariantCulture)" max="999999999" step="0.01" @bind="_amount" disabled="@_busy" required /><button class="btn btn-primary" type="submit" disabled="@_busy">@(_busy ? "Submitting..." : "Place Bid")</button></div></form>
            }
            else if (!_signedIn) { <a class="btn btn-primary" href="/login">Login</a> }
            @if (_buyer && _auction.Outcome == "Sold") { <a class="btn btn-outline-primary" href="@($"/buyer/orders/from-auction/{_auction.Id}")">My Winner Order</a> }
            <h2 class="mt-4">Bid History</h2>
            @if (_bids?.Items.Count > 0)
            {
                <div class="platform-table-wrap"><table class="table platform-table"><thead><tr><th>Amount</th><th>Accepted (SAST)</th></tr></thead><tbody>@foreach (var bid in _bids.Items) { <tr><td>@Money(bid.Amount)</td><td>@Time(bid.PlacedAt)</td></tr> }</tbody></table></div>
                <div class="review-pagination"><button class="btn btn-outline-secondary" disabled="@(_skip == 0 || _busy)" @onclick="PreviousAsync">Previous</button><span>@_bids.Total bid(s)</span><button class="btn btn-outline-secondary" disabled="@(_skip + 20 >= _bids.Total || _busy)" @onclick="NextAsync">Next</button></div>
            }
            else { <p>No bids yet.</p> }
        }
    }
</section>
@code {
    [Parameter] public Guid ListingId { get; set; }
    private ListingDto? _listing;
    private PublicAuctionDto? _auction;
    private PagedResult<PublicBidDto>? _bids;
    private bool _buyer, _signedIn, _loading, _busy;
    private decimal _amount;
    private int _skip;
    private string? _error, _notice;
    private readonly CancellationTokenSource _stop = new();
    private Task? _poll;
    private decimal Minimum => _auction is null ? 0 : _auction.CurrentPrice is { } top ? top + _auction.MinimumIncrement : _auction.StartingPrice;
    private string HostQuery => "host=" + Uri.EscapeDataString(Nav.ToAbsoluteUri(Nav.Uri).IdnHost);
    protected override async Task OnParametersSetAsync()
    {
        _loading = true; _listing = null; _auction = null; _bids = null; _error = _notice = null; _skip = 0;
        try
        {
            var user = (await Auth.GetAuthenticationStateAsync()).User;
            _signedIn = user.Identity?.IsAuthenticated == true; _buyer = user.IsInRole("Buyer");
            _listing = await Api.GetAsync<ListingDto>($"/api/marketplace/listings/{ListingId}?{HostQuery}");
            await RefreshAsync(); _amount = Minimum;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }
    protected override Task OnAfterRenderAsync(bool firstRender) { if (firstRender) _poll = PollAsync(); return Task.CompletedTask; }
    private async Task PollAsync()
    {
        try
        {
            while (true)
            {
                await Task.Delay(TimeSpan.FromSeconds(5), _stop.Token);
                await InvokeAsync(async () => { if (!_busy && !_loading) { await RefreshAsync(); StateHasChanged(); } });
            }
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
    }
    private async Task RefreshAsync()
    {
        if (_listing is null) return;
        var listingId = _listing.Id;
        try
        {
            var auctions = await Api.GetAsync<List<PublicAuctionDto>>($"/api/marketplace/listings/{ListingId}/auctions?{HostQuery}") ?? [];
            if (_listing?.Id != listingId) return;
            if (auctions.Count > 1) throw new InvalidOperationException("Auction setup requires reconciliation.");
            var auction = auctions.SingleOrDefault();
            var bids = auction is null ? null : await Api.GetAsync<PagedResult<PublicBidDto>>($"/api/marketplace/auctions/{auction.Id}/bids?{HostQuery}&skip={_skip}&take=20");
            if (_listing?.Id != listingId) return;
            _auction = auction; _bids = bids;
            _error = null;
        }
        catch (Exception ex) { if (_listing?.Id == listingId) { _error = ex.Message; _auction = null; _bids = null; } }
    }
    private async Task BidAsync()
    {
        if (_busy || _auction?.State != "Live") return;
        _busy = true; _error = _notice = null;
        try { await Api.PostAsync("/api/buyer/bids", new CreateBidRequest(ListingId, _amount)); _skip = 0; await RefreshAsync(); _notice = "Bid accepted."; _amount = Minimum; }
        catch (Exception ex) { await RefreshAsync(); _error = ex.Message; }
        finally { _busy = false; }
    }
    private async Task PreviousAsync() { _skip = Math.Max(0, _skip - 20); await RefreshAsync(); }
    private async Task NextAsync() { _skip += 20; await RefreshAsync(); }
    private string Money(decimal value) => $"{value:0.00} {_listing?.CurrencyCode}";
    private static string Time(DateTimeOffset? value) => value?.ToOffset(TimeSpan.FromHours(2)).ToString("dd MMM yyyy HH:mm:ss") ?? "-";
    public async ValueTask DisposeAsync() { _stop.Cancel(); if (_poll is not null) { try { await _poll; } catch (OperationCanceledException) { } } _stop.Dispose(); }
}
