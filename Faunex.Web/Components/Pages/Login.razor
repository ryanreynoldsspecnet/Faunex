@page "/login"
@rendermode InteractiveServer
@using Faunex.Web.Auth
@using Faunex.Application.Auth
@inject Faunex.Web.Api.FaunexApiClient Api
@inject Faunex.Web.Auth.TokenStore TokenStore
@inject Faunex.Web.Auth.JwtAuthStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject MarketplaceBranding Branding

<PageTitle>Login - @Branding.Name</PageTitle>

<h3>Login</h3>

@* .NET 10 Blazor Web App (InteractiveServer) requirement:
   Do not declare EditForm models as nested/private types inside .razor files.
   Component-scoped types can break circuit state serialization and crash during input binding.
   Use a top-level public model type in a shared namespace instead. *@

@* EditForm uses an EditContext created from the single _model instance.
   All inputs must bind to that same _model instance (do not reassign _model after creating _editContext).

   Note: Do not set FormName here. FormName participates in Blazor's enhanced form handling and can cause the browser
   to take over submission (bypassing EditForm's OnValidSubmit) depending on render mode/configuration. *@
@if (_challenge is not null)
{
    <form class="mb-3" @onsubmit="VerifyMfaAsync" @onsubmit:preventDefault>
        <h4>@(_useRecovery ? "Recovery code" : "Authenticator verification")</h4>
        @if (_error is not null) { <p class="alert alert-danger" role="alert">@_error</p> }
        <label class="form-label" for="mfa-login-code">@(_useRecovery ? "One-time recovery code" : "Six-digit authenticator code")</label>
        <input id="mfa-login-code" class="form-control mb-3" type="text" inputmode="@(_useRecovery ? "text" : "numeric")"
               autocomplete="one-time-code" maxlength="@(_useRecovery ? 40 : 6)" required disabled="@_isSubmitting" @bind="_code" />
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-primary" type="submit" disabled="@_isSubmitting">Verify and sign in</button>
            <button class="btn btn-outline-secondary" type="button" disabled="@_isSubmitting" @onclick="ToggleRecovery">@(_useRecovery ? "Use authenticator" : "Use a recovery code")</button>
            <button class="btn btn-outline-secondary" type="button" disabled="@_isSubmitting" @onclick="Restart">Start over</button>
        </div>
    </form>
}
else
{
<EditForm EditContext="_editContext" OnValidSubmit="LoginAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    @if (_error is not null)
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    @if (_success is not null)
    {
        <div class="alert alert-success" role="alert">@_success</div>
    }

    <div class="mb-3">
        <label class="form-label">Email</label>
        @* For InputText, use @bind-Value only. Do not set @bind-Value:event (can crash circuits in InteractiveServer). *@
        <InputText class="form-control" @bind-Value="_model.Email" disabled="@_isSubmitting" />
    </div>

    <div class="mb-3">
        <label class="form-label">Password</label>
        <div class="password-field">
            <InputText class="form-control" type="@(_showPassword ? "text" : "password")" @bind-Value="_model.Password" disabled="@_isSubmitting" />
            <button class="btn btn-outline-secondary" type="button" @onclick="() => _showPassword = !_showPassword" disabled="@_isSubmitting">
                @(_showPassword ? "Hide" : "Show")
            </button>
        </div>
    </div>

    @* Validation/submission is driven only by OnValidSubmit; the button must be type="submit" and have no @onclick handler. *@
    <button class="btn btn-primary" type="submit" disabled="@_isSubmitting">
        @(_isSubmitting ? "Logging in..." : "Login")
    </button>

    <div class="mt-3">
        <a href="/forgot-password">Forgot your password?</a>
    </div>
</EditForm>
}

@code {
    [SupplyParameterFromQuery(Name = "returnTo")] public string? ReturnTo { get; set; }
    private bool _isSubmitting;
    private bool _showPassword;
    private string? _error;
    private string? _success;
    private string? _pendingRedirectTo;
    private string? _challenge;
    private bool _useRecovery;
    private string _code = "";

    // Single model instance for the lifetime of the component instance.
    private readonly LoginFormModel _model = new();

    // Single EditContext bound to _model; do not recreate it after the form is rendered.
    private EditContext _editContext = default!;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_model);
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingRedirectTo is null)
        {
            return Task.CompletedTask;
        }

        var destination = _pendingRedirectTo;
        _pendingRedirectTo = null;
        Nav.NavigateTo(destination);

        return Task.CompletedTask;
    }

    // Match backend DTO contract exactly (Faunex.Api.Auth.LoginRequest).
    private sealed record LoginRequest(string Email, string Password);

    // Match backend DTO contract (Faunex.Api.Auth.AuthResponse) but only bind what we need.
    private sealed record AuthResponse(
        string? AccessToken,
        bool IsPlatformAdmin,
        IReadOnlyList<string>? Roles,
        string? MfaChallenge = null);

    private async Task LoginAsync()
    {
        if (_isSubmitting)
        {
            return;
        }

        _error = null;
        _success = null;
        _isSubmitting = true;

        try
        {
            var response = await Api.PostAsync<LoginRequest, AuthResponse>(
                "/api/auth/login",
                new LoginRequest(_model.Email, _model.Password));

            if (response?.MfaChallenge is { Length: > 0 } challenge)
            {
                _model.Password = "";
                _challenge = challenge;
                return;
            }
            await FinishAsync(response, false);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task VerifyMfaAsync()
    {
        if (_isSubmitting || _challenge is null) return;
        _error = null;
        _isSubmitting = true;
        try
        {
            var response = await Api.PostAsync<AdminMfaLogin, AuthResponse>("/api/auth/login/mfa",
                new(_challenge, _code, _useRecovery));
            await FinishAsync(response, _useRecovery);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _code = ""; _isSubmitting = false; }
    }

    private async Task FinishAsync(AuthResponse? response, bool recovered)
    {
        if (string.IsNullOrWhiteSpace(response?.AccessToken) || response.Roles is null)
        {
            _error = "Login failed.";
            return;
        }
        await TokenStore.SetTokenAsync(response.AccessToken);
        AuthStateProvider.NotifyUserAuthenticationStateChanged();
        var platform = RoleNavigation.IsPlatformUser(response.IsPlatformAdmin, response.Roles);
        var tenant = RoleNavigation.IsTenantAdmin(response.Roles);
        var platformHost = PlatformHostRules.IsPlatformHost(Nav.ToAbsoluteUri(Nav.Uri).Host);
        var destination = platform ? "/platform" : tenant ? "/tenant" : platformHost ? "/" : "/browse";
        if (recovered && (platform || tenant)) destination = "/account/security";
        else if (!platformHost && response.Roles.Contains("Buyer") && BuyerReturnRoute.Validate(ReturnTo) is { } returnRoute)
            destination = returnRoute;
        _challenge = null;
        _model.Password = "";
        _success = "Logged in successfully.";
        _pendingRedirectTo = destination;
    }
    private void ToggleRecovery() { _useRecovery = !_useRecovery; _code = ""; _error = null; }
    private void Restart() { _challenge = null; _useRecovery = false; _code = ""; _error = null; }
}
