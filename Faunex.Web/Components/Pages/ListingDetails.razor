@page "/listings/{ListingId:guid}"

@using Microsoft.AspNetCore.Components.Authorization

@inject Faunex.Web.Api.FaunexApiClient Api
@inject NavigationManager Nav

<section class="lot-detail">
<a class="order-back-link" href="/browse">Back to lots</a>

@if (_isPlatformHost)
{
    <div class="alert alert-info" role="status">
        Listing details are shown on tenant marketplace domains. Faunex is the platform workspace for tenant setup and administration.
    </div>

    <a class="btn btn-primary" href="/login">Platform Login</a>
}
else if (_isLoading)
{
    <p>Loading...</p>
}
else if (_error is not null)
{
    <p>@_error</p>
}
else if (_item is null)
{
    <p>Listing not found or no longer available</p>
}
else
{
    <PageTitle>@_item.Title</PageTitle>
    <div class="wishlist-lot-heading"><div><p class="storefront-eyebrow">Lot details</p><h1>@_item.Title</h1></div><WishlistSaveButton ListingId="ListingId" Title="@_item.Title" /></div>
    <div class="lot-detail-grid"><div>
        <ListingPhotoGallery ListingId="ListingId" Title="@_item.Title" />

        @if (!string.IsNullOrWhiteSpace(_item.Description))
        {
            <div class="mt-3">
                <h2>Description</h2>
                <p class="lot-description">@_item.Description</p>
            </div>
        }
    </div><div>
    <div class="lot-detail-price"><span>@(_item.BuyNowPrice.HasValue ? "Listed price" : "Starting bid")</span><strong>@GetPriceLabel(_item)</strong></div>
    <dl class="review-facts mb-4"><dt>Sale type</dt><dd>@GetSaleType(_item)</dd><dt>Location</dt><dd>@(_item.Location ?? "Not supplied")</dd><dt>Quantity</dt><dd>@_item.Quantity</dd></dl>

    @if (IsAuction(_item))
    {
        <div class="mb-3">
            <a class="btn btn-primary" href="/auctions/@_item.Id">View auction</a>
        </div>
    }

    else
    {
        <FixedPriceActions @key="ListingId" ListingId="ListingId" />
    }
    </div></div>
}
</section>

@code {
    [Parameter] public Guid ListingId { get; set; }

    private bool _isLoading;
    private bool _isPlatformHost;
    private string _host = string.Empty;
    private string? _error;
    private Faunex.Application.DTOs.ListingDto? _item;


    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        _item = null;
        _host = Nav.ToAbsoluteUri(Nav.Uri).Host;
        _isPlatformHost = PlatformHostRules.IsPlatformHost(_host);

        if (_isPlatformHost)
        {
            _isLoading = false;
            return;
        }

        try
        {
            var host = MarketplaceRoutes.HostQuery(_host);
            _item = await Api.GetPublicAsync<Faunex.Application.DTOs.ListingDto>($"/api/marketplace/listings/{ListingId}?host={host}");

        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static bool IsAuction(Faunex.Application.DTOs.ListingDto item)
        => !item.BuyNowPrice.HasValue;

    private static string GetSaleType(Faunex.Application.DTOs.ListingDto item)
        => item.BuyNowPrice.HasValue ? "Fixed Price" : "Auction";

    private static string GetPriceLabel(Faunex.Application.DTOs.ListingDto item)
    {
        if (item.BuyNowPrice.HasValue)
            return StorefrontPresentation.Money(item.BuyNowPrice.Value, item.CurrencyCode ?? "");

        return StorefrontPresentation.Money(item.StartingPrice ?? 0, item.CurrencyCode ?? "");
    }
}
