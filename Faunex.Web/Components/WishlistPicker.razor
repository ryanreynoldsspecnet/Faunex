@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject BuyerWishlists Wishlists
@inject IJSRuntime JS
@inject NavigationManager Nav
<dialog @ref="_dialog" class="wishlist-dialog" aria-labelledby="wishlist-dialog-title" data-busy="@(Wishlists.Busy ? "true" : "false")">
    <header><h2 id="wishlist-dialog-title">Save to wishlists</h2><button type="button" class="wishlist-icon-button" aria-label="Close wishlists" title="Close" disabled="@Wishlists.Busy" @onclick="CloseAsync"><img src="/icons/lucide/x.svg" width="22" height="22" alt="" /></button></header>
    <p class="wishlist-dialog-lot">@Wishlists.PickedTitle</p>
    @if (_error is not null) { <p class="alert alert-warning" role="alert">@_error</p><button type="button" class="btn btn-outline-secondary mb-3" disabled="@Wishlists.Busy" @onclick="LoadAsync">Refresh wishlists</button> }
    @if (_loading) { <p role="status">Loading your wishlists...</p> }
    else if (Wishlists.State is { } state)
    {
        <fieldset disabled="@Wishlists.Busy" class="wishlist-choices"><legend class="visually-hidden">Choose wishlists for this lot</legend>
            @foreach (var list in state.Lists) { <label><input type="checkbox" checked="@_selected.Contains(list.Id)" @onchange="e => Select(list.Id, e.Value is true)" /><span>@list.Name</span><small>@list.ListingIds.Count</small></label> }
            @if (state.Lists.Count == 0) { <p>Create your first wishlist below.</p> }
        </fieldset>
        @if (state.Lists.Count < 20)
        {
            <form class="wishlist-create-inline" @onsubmit="CreateAsync" @onsubmit:preventDefault><label for="picker-list-name">New wishlist</label><div><input id="picker-list-name" class="form-control" @bind="_name" maxlength="80" required disabled="@Wishlists.Busy" placeholder="For example, Breeding pairs" /><button class="btn btn-outline-primary" type="submit" disabled="@Wishlists.Busy">Create</button></div></form>
        }
        <footer><button type="button" class="btn btn-outline-secondary" disabled="@Wishlists.Busy" @onclick="CloseAsync">Cancel</button><button type="button" class="btn btn-primary" disabled="@(Wishlists.Busy || state.Lists.Count == 0)" @onclick="SaveAsync">@(Wishlists.Busy ? "Saving..." : "Save changes")</button></footer>
    }
</dialog>
@code {
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private DotNetObjectReference<WishlistPicker>? _reference;
    private Guid? _editing;
    private readonly HashSet<Guid> _selected = [];
    private bool _shown, _loading, _disposed;
    private string _name = "";
    private string? _error;
    protected override void OnInitialized() { Wishlists.Changed += Changed; Nav.LocationChanged += LocationChanged; }
    private void Changed() => _ = InvokeAsync(async () =>
    {
        if (_editing != Wishlists.PickedListing)
        {
            _editing = Wishlists.PickedListing; _selected.Clear(); _error = null; _name = "";
            if (_editing is not null) await LoadAsync();
        }
        StateHasChanged();
    });
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (Wishlists.PickedListing is not null && !_shown)
        {
            _shown = true;
            try
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/wishlist-dialog.js");
                if (_disposed) return;
                _reference ??= DotNetObjectReference.Create(this);
                if (Wishlists.PickedListing is not null) await _module.InvokeVoidAsync("open", _dialog, _reference);
                else _shown = false;
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { _shown = false; Wishlists.Close(); Nav.NavigateTo("/buyer/wishlists"); }
        }
        else if (Wishlists.PickedListing is null && _shown) { _shown = false; if (_module is not null) await _module.InvokeVoidAsync("close", _dialog); }
    }
    private async Task LoadAsync()
    {
        var id = _editing; _loading = true; _error = null;
        try { await Wishlists.RefreshAsync(); if (id == _editing && Wishlists.State is { } state) { _selected.Clear(); foreach (var list in state.Lists.Where(x => x.ListingIds.Contains(id!.Value))) _selected.Add(list.Id); if (_selected.Count == 0 && state.Lists.Count == 1) _selected.Add(state.Lists[0].Id); } }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }
    private void Select(Guid id, bool selected) { if (selected) _selected.Add(id); else _selected.Remove(id); }
    private async Task CreateAsync() { _error = null; try { _selected.Add(await Wishlists.CreateAsync(_name)); _name = ""; } catch (Exception ex) { _error = ex.Message; } }
    private async Task SaveAsync() { if (_editing is not { } id) return; _error = null; try { await Wishlists.SaveAsync(id, _selected.ToList()); if (Wishlists.PickedListing == id) await CloseAsync(); } catch (Exception ex) { _error = ex.Message; } }
    private Task CloseAsync() { if (!Wishlists.Busy) Wishlists.Close(); return Task.CompletedTask; }
    [JSInvokable] public void Closed() { _shown = false; Wishlists.Close(); }
    private void LocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => Wishlists.Close();
    public async ValueTask DisposeAsync()
    {
        _disposed = true; Wishlists.Changed -= Changed; Nav.LocationChanged -= LocationChanged;
        if (_module is not null) { try { await _module.InvokeVoidAsync("dispose", _dialog); await _module.DisposeAsync(); } catch (JSDisconnectedException) { } }
        _reference?.Dispose();
    }
}
